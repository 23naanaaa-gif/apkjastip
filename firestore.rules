rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Penyimpanan Terpusat (Centralized Shared Database)
    // Semua user yang sudah login (authenticated) dengan email masing-masing
    // dapat melihat, menambah, mengubah, dan menghapus data bersama secara real-time.
    
    match /stock_barang/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /barang_terjual/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /biaya_ongkir/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /riwayat_aktivitas/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
